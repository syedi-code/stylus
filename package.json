{
	"name": "stylus",
	"description": "Notes, thoughts, quotes and essays. The writing half of alexandria.",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host --port 4571",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"deploy": "npm run build && wrangler pages deploy dist"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.17",
		"axios": "^1.13.2",
		"html-to-image": "^1.11.13",
		"tailwindcss": "^4.1.17",
		"vue": "^3.5.24"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/tsconfig": "^0.8.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.4",
		"vitest": "^5.0.1",
		"vue-tsc": "^3.1.4",
		"wrangler": "^4.90.0"
	}
}
